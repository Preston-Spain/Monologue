{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build Monologue",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\Monologue.exe",
                "${fileDirname}\\main.cpp",
                "${fileDirname}\\core_ai.cpp",
                "${fileDirname}\\Util.cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$msCompile"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the whole Monologue project, not just the active file."
        }
    ],
    "version": "2.0.0"
}